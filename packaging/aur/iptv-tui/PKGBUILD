# Maintainer: Kinn Coelho Juliao <kinncj@gmail.com>
pkgname=iptv-tui
pkgver=1.3.0
pkgrel=1
pkgdesc="IPTV TUI — browse free IPTV playlists (iptv-org, Free-TV) by country/category and play them"
arch=('x86_64' 'aarch64')
url="https://github.com/kinncj/iptv"
license=('AGPL-3.0-or-later')
depends=('glibc')
makedepends=('go>=1.26')
optdepends=('mpv: inline terminal playback and best HLS support'
            'vlc: alternate external player'
            'ffmpeg: ffplay fallback player')
provides=('iptv-tui')
conflicts=('iptv-tui-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/kinncj/iptv/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "iptv-$pkgver"
    export GOPATH="$srcdir/gopath"
    go mod download
}

build() {
    cd "iptv-$pkgver"
    export GOPATH="$srcdir/gopath" CGO_ENABLED=0
    go build -trimpath -mod=readonly -ldflags "-s -w -X main.version=$pkgver" -o iptv-tui ./app
}

package() {
    cd "iptv-$pkgver"
    install -Dm755 iptv-tui "$pkgdir/usr/bin/iptv-tui"
    install -Dm644 packaging/iptv-tui.1 "$pkgdir/usr/share/man/man1/iptv-tui.1"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
